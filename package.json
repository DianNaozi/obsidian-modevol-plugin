    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "codemirror": "^6.0.1",
    "esbuild": "0.17.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "obsidian": "latest",
    "ts-jest": "^29.1.2",
    "tslib": "2.4.0",
